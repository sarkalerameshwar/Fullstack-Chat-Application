# Backend application secrets (set these in your deployment platform's secret store)
DB_URL=mongodb://username:password@your-mongodb-host:27017/chat_db?authSource=admin
JWT_SECRET=generate-a-long-random-secret
JWT_REFRESH_SECRET=generate-a-different-long-random-secret
CLIENT_URL=https://your-domain.example
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
EMAIL_USER=your-gmail-address
EMAIL_PASS=your-gmail-app-password

# Needed only when deploying the coturn service from docker-compose.yml.
TURN_SHARED_SECRET=generate-a-third-long-random-secret
TURN_REALM=turn.your-domain.example
TURN_CERTS_DIR=/absolute/path/to/turn-tls-certificates
