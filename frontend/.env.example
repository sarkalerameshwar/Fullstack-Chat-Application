# Firebase Client Configuration (Vite requires VITE_ prefix)
# These values are baked into the frontend at BUILD time (npm run build / Docker build).
# For VPS/production: set them in GitHub Actions secrets OR in the root .env used by docker-compose.prod.yml
VITE_FIREBASE_API_KEY=AIzaSy...your_actual_firebase_api_key...
VITE_FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-app-id
VITE_FIREBASE_STORAGE_BUCKET=your-app.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# --- Firebase Console setup for production (chattx.app) ---
# 1. Firebase Console → Authentication → Settings → Authorized domains
#    Add: chattx.app, www.chattx.app
# 2. Google Cloud Console → APIs & Services → Credentials → your Web API key
#    Application restrictions → HTTP referrers, add:
#      https://chattx.app/*
#      https://www.chattx.app/*
#      http://localhost:5173/*   (local dev)
# 3. Rebuild and redeploy the frontend after changing these values.
